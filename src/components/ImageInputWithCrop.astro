---
interface Props {
  id: string
  name: string
  label: string
  caption?: string
  aspectRatio: number
  required?: boolean
}

const { id, name, label, caption, aspectRatio, required } = Astro.props

const MAX_WIDTH = 480
const viewportHeight = Math.min(Math.round(MAX_WIDTH / aspectRatio), 380)
const actualViewportWidth = Math.min(MAX_WIDTH, Math.round(viewportHeight * aspectRatio))

const OUTPUT_WIDTH = 1200
const outputHeight = Math.round(OUTPUT_WIDTH / aspectRatio)
---
<div
  class="w-full"
  x-data={`imageInputWithCrop('${id}', ${aspectRatio}, ${OUTPUT_WIDTH}, ${outputHeight}, ${actualViewportWidth}, ${viewportHeight})`}
>
  <label class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">
    {label}
    {!required && <span class="text-xs text-gray-500">(valfritt)</span>}
  </label>

  <!-- Actual file input submitted with form -->
  <input type="file" id={id} name={name} class="sr-only" accept="image/*" tabindex="-1" />

  <!-- Hidden file picker (no name = not submitted) -->
  <input
    type="file"
    x-ref="picker"
    class="hidden"
    accept="image/*"
    x-on:change="onFileSelected($event)"
  />

  <div class="flex items-center gap-4 flex-wrap">
    <button
      type="button"
      x-on:click="$refs.picker.click()"
      class="text-gray-900 bg-white rounded-lg border border-gray-200 hover:bg-gray-100 hover:text-blue-700 focus:z-10 focus:ring-4 focus:ring-gray-100 dark:focus:ring-gray-700 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-600 dark:hover:text-white dark:hover:bg-gray-700 font-medium text-sm px-3 py-2"
    >
      Välj och beskär bild
    </button>

    <img
      x-show="previewUrl"
      x-bind:src="previewUrl"
      class="h-16 rounded border border-gray-200 object-cover"
      alt="Förhandsgranskning"
    />
  </div>

  {
    caption && (
      <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">{caption}</p>
    )
  }

  <!-- Crop modal -->
  <div
    x-show="showModal"
    x-cloak
    class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60"
    x-on:keydown.escape.window="cancelCrop()"
  >
    <div class="bg-white rounded-lg shadow-xl w-full max-w-xl overflow-hidden">
      <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200">
        <h3 class="text-lg font-semibold text-gray-900">Beskär bild</h3>
        <button
          type="button"
          x-on:click="cancelCrop()"
          class="text-gray-400 hover:text-gray-600 rounded-lg p-1 hover:bg-gray-100"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
          <span class="sr-only">Stäng</span>
        </button>
      </div>

      <div class="p-6 flex justify-center">
        <div x-ref="croppieEl"></div>
      </div>

      <div class="flex justify-end gap-3 px-6 py-4 border-t border-gray-200 bg-gray-50">
        <button
          type="button"
          x-on:click="cancelCrop()"
          class="text-gray-900 bg-white rounded-lg border border-gray-200 hover:bg-gray-100 font-medium text-sm px-5 py-2.5"
        >
          Avbryt
        </button>
        <button
          type="button"
          x-on:click="confirmCrop()"
          class="text-white bg-orange-500 hover:bg-orange-600 focus:ring-4 focus:ring-orange-300 font-medium rounded-lg text-sm px-5 py-2.5"
        >
          Använd bild
        </button>
      </div>
    </div>
  </div>
</div>
